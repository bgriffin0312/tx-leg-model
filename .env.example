# Copy this file to .env and fill in values as data sources are identified
# .env is gitignored and should never be committed

# FollowTheMoney — campaign finance API (https://www.followthemoney.org)
FOLLOWTHEMONEY_API_KEY=

# Google Gemini — used by ask_gemini.py (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Datawrapper — used by scripts/sync_datawrapper.py
# Token: app.datawrapper.de/account/api-tokens (needs chart:read + chart:write scopes)
# Chart IDs: the short string in each chart's edit URL after you create it
DATAWRAPPER_TOKEN=
DW_CHART_HOUSE=
DW_CHART_SENATE=
DW_CHART_WAR=
